  "widgets": [
    {
      "key": "fuel_prices",
      "label": {
        "en": "Fuel prices",
        "fr": "Prix des carburants",
        "de": "Kraftstoffpreise",
        "es": "Precios de carburantes"
      },
      "description": {
        "en": "The prices of a station, or the cheapest around the house, per fuel followed.",
        "fr": "Les prix d’une station, ou les moins chers autour de la maison, par carburant suivi.",
        "de": "Die Preise einer Tankstelle oder die günstigsten ums Haus, je verfolgtem Kraftstoff.",
        "es": "Los precios de una gasolinera, o los más baratos cerca de casa, por carburante seguido."
      },
      "icon": "droplet",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station or cheapest device",
            "fr": "Station ou appareil du moins cher",
            "de": "Tankstelle oder Gerät des günstigsten Preises",
            "es": "Gasolinera o dispositivo del más barato"
          },
          "description": {
            "en": "Empty: the cheapest around the house.",
