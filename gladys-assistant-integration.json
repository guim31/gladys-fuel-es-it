{
  "manifest_version": 1,
  "type": "device",
  "name": "Fuel prices Spain & Italy",
  "description": {
    "en": "Fuel prices at the stations of Spain and Italy, from the official open data, without account.",
    "fr": "Prix des carburants des stations d’Espagne et d’Italie, données ouvertes officielles, sans compte.",
    "de": "Kraftstoffpreise der Tankstellen in Spanien und Italien, aus offenen amtlichen Daten, ohne Konto.",
    "es": "Precios de carburantes en gasolineras de España e Italia, datos abiertos oficiales, sin cuenta."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-fuel-es-it:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-fuel-es-it/main/cover.png",
  "categories": ["transport", "energy"],
  "countries": ["ES", "IT"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Official open data",
        "fr": "Données ouvertes officielles",
        "de": "Offene amtliche Daten",
        "es": "Datos abiertos oficiales"
      },
      "description": {
        "en": "Spain: the Ministry’s list, updated every 30 minutes. Italy: the MIMIT files, once a day (prices of the day before). The stations are searched around the house located in Gladys and/or in a municipality. Not affiliated with either ministry.",
        "fr": "Espagne : la liste du ministère, mise à jour toutes les 30 minutes. Italie : les fichiers du MIMIT, une fois par jour (prix de la veille). Les stations sont cherchées autour de la maison placée dans Gladys et/ou dans une commune. Sans lien avec ces ministères.",
        "de": "Spanien: die Liste des Ministeriums, alle 30 Minuten aktualisiert. Italien: die Dateien des MIMIT, einmal am Tag (Preise vom Vortag). Die Tankstellen werden um das in Gladys verortete Haus und/oder in einer Gemeinde gesucht. Nicht mit diesen Ministerien verbunden.",
        "es": "España: la lista del Ministerio, actualizada cada 30 minutos. Italia: los archivos del MIMIT, una vez al día (precios del día anterior). Las gasolineras se buscan alrededor de la casa ubicada en Gladys y/o en un municipio. Sin relación con estos ministerios."
      },
      "links": [
        {
          "url": "https://geoportalgasolineras.es/",
          "label": {
            "en": "Geoportal of fuel stations (Spain)",
            "fr": "Géoportail des stations (Espagne)",
            "de": "Geoportal der Tankstellen (Spanien)",
            "es": "Geoportal Gasolineras (España)"
          }
        },
        {
          "url": "https://www.mimit.gov.it/it/open-data/elenco-dataset/carburanti-prezzi-praticati-e-anagrafica-degli-impianti",
          "label": {
            "en": "MIMIT open data (Italy)",
            "fr": "Données ouvertes du MIMIT (Italie)",
            "de": "Offene Daten des MIMIT (Italien)",
            "es": "Datos abiertos del MIMIT (Italia)"
          }
        }
      ]
    },
    {
      "key": "country",
      "type": "select",
      "label": {
        "en": "Country",
        "fr": "Pays",
        "de": "Land",
        "es": "País"
      },
      "description": {
        "en": "The country of the stations followed.",
        "fr": "Le pays des stations suivies.",
        "de": "Das Land der verfolgten Tankstellen.",
        "es": "El país de las gasolineras seguidas."
      },
      "required": true,
      "default": "es",
      "options": [
        {
          "value": "es",
          "label": {
            "en": "Spain",
            "fr": "Espagne",
            "de": "Spanien",
            "es": "España"
          }
        },
        {
          "value": "it",
          "label": {
            "en": "Italy",
            "fr": "Italie",
            "de": "Italien",
            "es": "Italia"
          }
        }
      ]
    },
    {
      "key": "fuels",
      "type": "multi_select",
      "label": {
        "en": "Fuels to follow",
        "fr": "Carburants à suivre",
        "de": "Verfolgte Kraftstoffe",
        "es": "Carburantes a seguir"
      },
      "description": {
        "en": "Only the fuels of the chosen country are used. Italy: self-service and served prices apart.",
        "fr": "Seuls les carburants du pays choisi sont utilisés. Italie : prix en libre-service et servi séparés.",
        "de": "Nur die Kraftstoffe des gewählten Landes zählen. Italien: SB- und Bedienpreise getrennt.",
        "es": "Solo se usan los carburantes del país elegido. Italia: precios de autoservicio y atendidos por separado."
      },
      "required": false,
      "default": ["gasolina_95", "gasoleo_a", "benzina_self", "gasolio_self"],
      "options": [
        {
          "value": "gasolina_95",
          "label": {
            "en": "Unleaded 95 (Spain)",
            "fr": "Sans plomb 95 (Espagne)",
            "de": "Super 95 (Spanien)",
            "es": "Gasolina 95 (España)"
          }
        },
        {
          "value": "gasolina_98",
          "label": {
            "en": "Unleaded 98 (Spain)",
            "fr": "Sans plomb 98 (Espagne)",
            "de": "Super Plus 98 (Spanien)",
            "es": "Gasolina 98 (España)"
          }
        },
        {
          "value": "gasoleo_a",
          "label": {
            "en": "Diesel (Spain)",
            "fr": "Gazole (Espagne)",
            "de": "Diesel (Spanien)",
            "es": "Gasóleo A (España)"
          }
        },
        {
          "value": "gasoleo_premium",
          "label": {
            "en": "Premium diesel (Spain)",
            "fr": "Gazole premium (Espagne)",
            "de": "Premium-Diesel (Spanien)",
            "es": "Gasóleo Premium (España)"
          }
        },
        {
          "value": "glp",
          "label": {
            "en": "LPG (Spain)",
            "fr": "GPL (Espagne)",
            "de": "Autogas (Spanien)",
            "es": "GLP (España)"
          }
        },
        {
          "value": "benzina_self",
          "label": {
            "en": "Petrol, self-service (Italy)",
            "fr": "Essence, libre-service (Italie)",
            "de": "Benzin, SB (Italien)",
            "es": "Gasolina, autoservicio (Italia)"
          }
        },
        {
          "value": "benzina_served",
          "label": {
            "en": "Petrol, served (Italy)",
            "fr": "Essence, servie (Italie)",
            "de": "Benzin, bedient (Italien)",
            "es": "Gasolina, atendida (Italia)"
          }
        },
        {
          "value": "gasolio_self",
          "label": {
            "en": "Diesel, self-service (Italy)",
            "fr": "Gazole, libre-service (Italie)",
            "de": "Diesel, SB (Italien)",
            "es": "Gasóleo, autoservicio (Italia)"
          }
        },
        {
          "value": "gasolio_served",
          "label": {
            "en": "Diesel, served (Italy)",
            "fr": "Gazole, servi (Italie)",
            "de": "Diesel, bedient (Italien)",
            "es": "Gasóleo, atendido (Italia)"
          }
        },
        {
          "value": "gpl",
          "label": {
            "en": "LPG (Italy)",
            "fr": "GPL (Italie)",
            "de": "Autogas (Italien)",
            "es": "GLP (Italia)"
          }
        },
        {
          "value": "metano",
          "label": {
            "en": "Methane (CNG) (Italy)",
            "fr": "Méthane (GNV) (Italie)",
            "de": "Erdgas (CNG) (Italien)",
            "es": "Metano (GNC) (Italia)"
          }
        }
      ]
    },
    {
      "key": "radius_km",
      "type": "number",
      "label": {
        "en": "Search radius (km)",
        "fr": "Rayon de recherche (km)",
        "de": "Suchradius (km)",
        "es": "Radio de búsqueda (km)"
      },
      "description": {
        "en": "Around the house located in Gladys: the stations listed in Discovery and the cheapest price.",
        "fr": "Autour de la maison placée dans Gladys : les stations listées dans Découverte et le prix le plus bas.",
        "de": "Um das in Gladys verortete Haus: die in der Erkennung gelisteten Tankstellen und der niedrigste Preis.",
        "es": "Alrededor de la casa ubicada en Gladys: las gasolineras listadas en Descubrimiento y el precio más bajo."
      },
      "required": false,
      "default": 5,
      "min": 1,
      "max": 30
    },
    {
      "key": "town",
      "type": "string",
      "label": {
        "en": "Municipality (optional)",
        "fr": "Commune (facultatif)",
        "de": "Gemeinde (optional)",
        "es": "Municipio (opcional)"
      },
      "description": {
        "en": "Its stations are listed too. Without a located house, the cheapest price is searched there.",
        "fr": "Ses stations sont aussi listées. Sans maison placée, le prix le plus bas y est cherché.",
        "de": "Die Tankstellen dort werden auch gelistet. Ohne verortetes Haus wird dort der niedrigste Preis gesucht.",
        "es": "Sus gasolineras también se listan. Sin casa ubicada, el precio más bajo se busca allí."
      },
      "placeholder": {
        "en": "e.g. Madrid, Roma",
        "fr": "ex. Madrid, Roma",
        "de": "z. B. Madrid, Roma",
        "es": "p. ej. Madrid, Roma"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Names of the devices and features (frozen when a device is added), dates and trigger texts.",
        "fr": "Noms des appareils et fonctionnalités (figés à l’ajout d’un appareil), dates et textes du déclencheur.",
        "de": "Namen der Geräte und Funktionen (beim Hinzufügen festgelegt), Daten und Texte des Auslösers.",
        "es": "Nombres de dispositivos y funciones (fijados al añadir un dispositivo), fechas y textos del disparador."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "English",
            "de": "English",
            "es": "English"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "Français",
            "fr": "Français",
            "de": "Français",
            "es": "Français"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "Deutsch",
            "fr": "Deutsch",
            "de": "Deutsch",
            "es": "Deutsch"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Español",
            "fr": "Español",
            "de": "Español",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_source",
      "label": {
        "en": "Test the official price list",
        "fr": "Tester la liste officielle des prix",
        "de": "Offizielle Preisliste testen",
        "es": "Probar la lista oficial de precios"
      },
      "description": {
        "en": "Reads the list now and says how many stations are found, and the cheapest price.",
        "fr": "Lit la liste tout de suite, et donne le nombre de stations trouvées et le prix le plus bas.",
        "de": "Liest die Liste sofort und nennt die Zahl der gefundenen Tankstellen und den niedrigsten Preis.",
        "es": "Lee la lista ahora e indica cuántas gasolineras se encuentran y el precio más bajo."
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "price_drop",
      "label": {
        "en": "Fuel price drop",
        "fr": "Baisse du prix d’un carburant",
        "de": "Kraftstoffpreis gesunken",
        "es": "Bajada del precio de un carburante"
      },
      "description": {
        "en": "A price falls on a station added in Gladys, or on the cheapest device. A threshold is a plain scene on the price feature.",
        "fr": "Un prix baisse sur une station ajoutée dans Gladys, ou sur l’appareil du moins cher. Un seuil se fait par une scène sur la fonctionnalité de prix.",
        "de": "Ein Preis sinkt bei einer in Gladys hinzugefügten Tankstelle oder beim Gerät des günstigsten Preises. Eine Schwelle geht per Szene auf der Preisfunktion.",
        "es": "Un precio baja en una gasolinera añadida en Gladys, o en el dispositivo del más barato. Un umbral se hace con una escena sobre la función de precio."
      },
      "fields": [
