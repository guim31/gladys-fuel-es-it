        {
          "key": "show_details",
          "type": "boolean",
          "label": {
            "en": "Show the details",
            "fr": "Afficher les détails",
            "de": "Details anzeigen",
            "es": "Mostrar los detalles"
          },
          "description": {
            "en": "Station and distance of each cheapest price, or the opening hours.",
            "fr": "Station et distance de chaque prix le plus bas, ou les horaires.",
